# name: test/sql/adbc_catalog.test
# description: test adbc catalog functions (adbc_info, adbc_tables, adbc_columns, adbc_schema, adbc_table_types)
# group: [adbc]

require adbc_scanner

require-env HAS_ADBC_SQLITE_DRIVER

# ============================================
# NULL Database Name Tests
# ============================================

# Test adbc_info with NULL database name
statement error
SELECT * FROM adbc_info(NULL);
----
Invalid Input Error: adbc_info: database name cannot be NULL

# Test adbc_tables with NULL database name
statement error
SELECT * FROM adbc_tables(NULL);
----
Invalid Input Error: adbc_tables: database name cannot be NULL

# Test adbc_table_types with NULL database name
statement error
SELECT * FROM adbc_table_types(NULL);
----
Invalid Input Error: adbc_table_types: database name cannot be NULL

# Test adbc_columns with NULL database name
statement error
SELECT * FROM adbc_columns(NULL);
----
Invalid Input Error: adbc_columns: database name cannot be NULL

# Test adbc_schema with NULL database name
statement error
SELECT * FROM adbc_schema(NULL, 'test');
----
Invalid Input Error: adbc_schema: database name cannot be NULL

# Test adbc_schema with NULL table name
statement error
SELECT * FROM adbc_schema('nope', NULL);
----
Invalid Input Error: adbc_schema: Table name cannot be NULL

# ============================================
# Normal Tests
# ============================================

statement ok
ATTACH '__TEST_DIR__/adbc_catalog.db' AS db (TYPE adbc, driver 'sqlite');

# ============================================
# adbc_info Tests
# ============================================

# Test adbc_info - returns driver/database info
query II
SELECT * FROM adbc_info('db') WHERE info_name = 'vendor_name';
----
vendor_name	SQLite

# A database that is not an ADBC attachment is rejected
statement ok
ATTACH ':memory:' AS plain_duckdb;

statement error
SELECT * FROM adbc_info('plain_duckdb');
----
Binder Error: adbc_info: "plain_duckdb" is a duckdb database, not an ADBC one

# The alias resolves case-insensitively like any catalog
query II
SELECT * FROM adbc_info('DB') WHERE info_name = 'vendor_name';
----
vendor_name	SQLite

# Test adbc_info - all required info fields should be present
query I
SELECT COUNT(*) >= 3 FROM adbc_info('db');
----
true

# Test adbc_info with an unknown database name
statement error
SELECT * FROM adbc_info('nope');
----
Binder Error: adbc_info: no attached database named "nope"

# ============================================
# adbc_tables Tests
# ============================================

# Test adbc_tables with empty database (no tables created yet)
query I
SELECT COUNT(*) FROM adbc_tables('db');
----
0

# Test adbc_tables with an unknown database name
statement error
SELECT * FROM adbc_tables('nope');
----
Binder Error: adbc_tables: no attached database named "nope"

# ============================================
# adbc_table_types Tests
# ============================================

# Test adbc_table_types - returns supported table types
query I
SELECT * FROM adbc_table_types('db') ORDER BY table_type;
----
table
view

# Test adbc_table_types with an unknown database name
statement error
SELECT * FROM adbc_table_types('nope');
----
Binder Error: adbc_table_types: no attached database named "nope"

# ============================================
# adbc_columns Tests
# ============================================

# Create a table for column tests
statement ok
CALL adbc_execute('db', 'CREATE TABLE test_cols (id INTEGER PRIMARY KEY, name TEXT NOT NULL, value REAL)');

# Test adbc_columns - basic query
query IIII
SELECT table_name, column_name, ordinal_position, type_name FROM adbc_columns('db', table_name := 'test_cols') ORDER BY ordinal_position;
----
test_cols	id	1	INTEGER
test_cols	name	2	TEXT
test_cols	value	3	REAL

# Test adbc_columns - filter by column_name
query II
SELECT table_name, column_name FROM adbc_columns('db', table_name := 'test_cols', column_name := 'name');
----
test_cols	name

# Test adbc_columns with an unknown database name
statement error
SELECT * FROM adbc_columns('nope');
----
Binder Error: adbc_columns: no attached database named "nope"

# ============================================
# adbc_schema Tests
# ============================================

# Create a table for schema tests
statement ok
CALL adbc_execute('db', 'CREATE TABLE schema_test (id INTEGER, name TEXT, value REAL)');

# Test adbc_schema - get Arrow schema for a table
query I
SELECT field_name FROM adbc_schema('db', 'schema_test') ORDER BY field_name;
----
id
name
value

# Test adbc_schema with an unknown database name
statement error
SELECT * FROM adbc_schema('nope', 'test');
----
Binder Error: adbc_schema: no attached database named "nope"

# Clean up
statement ok
DETACH db;
