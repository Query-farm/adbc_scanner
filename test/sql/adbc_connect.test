# name: test/sql/adbc_connect.test
# description: connecting with ATTACH and naming the attached database in adbc_* functions
# group: [adbc]

# Before we load the extension, this will fail
statement error
SELECT * FROM adbc_info('db');
----
Catalog Error: Table Function with name adbc_info does not exist!

# Require statement will ensure this test is run with this extension loaded
require adbc_scanner

require-env HAS_ADBC_SQLITE_DRIVER

# ATTACH requires a 'driver' option (or a connection profile)
statement error
ATTACH '__TEST_DIR__/adbc_connect.db' AS db (TYPE adbc);
----
Invalid Input Error: ADBC connection requires a 'driver' option

# The functions name an attached ADBC database
statement error
SELECT * FROM adbc_info('nope');
----
Binder Error: adbc_info: no attached database named "nope"

statement ok
ATTACH ':memory:' AS plain_duckdb;

statement error
SELECT * FROM adbc_scan('plain_duckdb', 'SELECT 1');
----
Binder Error: adbc_scan: "plain_duckdb" is a duckdb database, not an ADBC one

statement error
SELECT * FROM adbc_scan(NULL, 'SELECT 1');
----
database name cannot be NULL

statement ok
ATTACH '__TEST_DIR__/adbc_connect.db' AS db (TYPE adbc, driver 'sqlite');

# The driver is reported through adbc_info
query I
SELECT count(*) > 0 FROM adbc_info('db') WHERE info_value ILIKE '%sqlite%';
----
true

# The alias is what names it, case-insensitively like any catalog
query I
SELECT * FROM adbc_scan('DB', 'SELECT 42 AS answer', columns := {'answer': 'BIGINT'});
----
42

statement ok
ATTACH '__TEST_DIR__/adbc_connect_other.db' AS other_alias (TYPE adbc, driver 'sqlite');

query I
SELECT * FROM adbc_scan('other_alias', 'SELECT 7 AS n', columns := {'n': 'BIGINT'});
----
7

statement ok
DETACH db;

statement ok
DETACH other_alias;

statement ok
DETACH plain_duckdb;

# After DETACH the name no longer resolves
statement error
SELECT * FROM adbc_scan('db', 'SELECT 1');
----
Binder Error: adbc_scan: no attached database named "db"
