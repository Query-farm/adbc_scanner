# name: test/sql/adbc_execute.test
# description: test adbc_execute function for DDL/DML statements
# group: [adbc]

require adbc_scanner

require-env HAS_ADBC_SQLITE_DRIVER

# ============================================
# NULL Connection Handle Tests
# ============================================

# Test adbc_execute with NULL connection handle
statement error
CALL adbc_execute(NULL, 'SELECT 1');
----
Invalid Input Error: adbc_execute: Connection handle cannot be NULL

# Test adbc_execute with NULL query
statement error
CALL adbc_execute(12345, NULL);
----
Invalid Input Error: adbc_execute: Query cannot be NULL

# ============================================
# Normal Tests
# ============================================

statement ok
SET VARIABLE conn_id = (SELECT adbc_connect({'driver': 'sqlite', 'uri': ':memory:'}));

# Test CREATE TABLE
statement ok
CALL adbc_execute(getvariable('conn_id')::BIGINT, 'CREATE TABLE exec_test (id INTEGER PRIMARY KEY, name TEXT)');

# Test INSERT
statement ok
CALL adbc_execute(getvariable('conn_id')::BIGINT, 'INSERT INTO exec_test VALUES (1, ''hello''), (2, ''world'')');

# Verify data was inserted
query II
SELECT * FROM adbc_scan(getvariable('conn_id')::BIGINT, 'SELECT * FROM exec_test ORDER BY id', columns := {'id': 'BIGINT', 'name': 'VARCHAR'});
----
1	hello
2	world

# Test UPDATE
statement ok
CALL adbc_execute(getvariable('conn_id')::BIGINT, 'UPDATE exec_test SET name = ''updated'' WHERE id = 1');

# Verify update worked
query II
SELECT * FROM adbc_scan(getvariable('conn_id')::BIGINT, 'SELECT * FROM exec_test WHERE id = 1', columns := {'id': 'BIGINT', 'name': 'VARCHAR'});
----
1	updated

# Test DELETE
statement ok
CALL adbc_execute(getvariable('conn_id')::BIGINT, 'DELETE FROM exec_test WHERE id = 2');

# Verify delete worked
query I
SELECT COUNT(*) FROM adbc_scan(getvariable('conn_id')::BIGINT, 'SELECT * FROM exec_test', columns := {'id': 'BIGINT', 'name': 'VARCHAR'});
----
1

# Test adbc_execute with invalid connection handle
statement error
CALL adbc_execute(12345, 'SELECT 1');
----
Invalid Input Error: adbc_execute: Invalid connection handle: 12345

# Clean up
statement ok
CALL adbc_disconnect(getvariable('conn_id')::BIGINT);
