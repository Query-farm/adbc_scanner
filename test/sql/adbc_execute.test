# name: test/sql/adbc_execute.test
# description: test adbc_execute function for DDL/DML statements
# group: [adbc]

require adbc_scanner

require-env HAS_ADBC_SQLITE_DRIVER

# ============================================
# Database Name Tests
# ============================================

# Test adbc_execute with NULL database name
statement error
CALL adbc_execute(NULL, 'SELECT 1');
----
Invalid Input Error: adbc_execute: database name cannot be NULL

# Test adbc_execute with NULL query
statement error
CALL adbc_execute('nope', NULL);
----
Invalid Input Error: adbc_execute: Query cannot be NULL

# ============================================
# Normal Tests
# ============================================

statement ok
ATTACH '__TEST_DIR__/adbc_execute.db' AS exec_db (TYPE adbc, driver 'sqlite');

# Test CREATE TABLE
statement ok
CALL adbc_execute('exec_db', 'CREATE TABLE exec_test (id INTEGER PRIMARY KEY, name TEXT)');

# Test INSERT
statement ok
CALL adbc_execute('exec_db', 'INSERT INTO exec_test VALUES (1, ''hello''), (2, ''world'')');

# Verify data was inserted
query II
SELECT * FROM adbc_scan('exec_db', 'SELECT * FROM exec_test ORDER BY id', columns := {'id': 'BIGINT', 'name': 'VARCHAR'});
----
1	hello
2	world

# Test UPDATE
statement ok
CALL adbc_execute('exec_db', 'UPDATE exec_test SET name = ''updated'' WHERE id = 1');

# Verify update worked
query II
SELECT * FROM adbc_scan('exec_db', 'SELECT * FROM exec_test WHERE id = 1', columns := {'id': 'BIGINT', 'name': 'VARCHAR'});
----
1	updated

# Test DELETE
statement ok
CALL adbc_execute('exec_db', 'DELETE FROM exec_test WHERE id = 2');

# Verify delete worked
query I
SELECT COUNT(*) FROM adbc_scan('exec_db', 'SELECT * FROM exec_test', columns := {'id': 'BIGINT', 'name': 'VARCHAR'});
----
1

# Test adbc_execute with an unknown database name
statement error
CALL adbc_execute('nope', 'SELECT 1');
----
Binder Error: adbc_execute: no attached database named "nope"

# Clean up
statement ok
DETACH exec_db;
