# name: test/sql/adbc_insert.test
# description: test adbc_insert function for bulk data ingestion
# group: [adbc]

require adbc_scanner

require-env HAS_ADBC_SQLITE_DRIVER

# ============================================
# NULL Database Name Tests
# ============================================

# Test adbc_insert with NULL database name
statement error
SELECT * FROM adbc_insert(NULL, 'test', (SELECT 1));
----
Invalid Input Error: adbc_insert: database name cannot be NULL

# Test adbc_insert with NULL table name
statement error
SELECT * FROM adbc_insert('nope', NULL, (SELECT 1));
----
Invalid Input Error: adbc_insert: Target table name cannot be NULL

# ============================================
# Normal Tests
# ============================================

statement ok
ATTACH '__TEST_DIR__/adbc_insert.db' AS db (TYPE adbc, driver 'sqlite');

# Create source data (20,000 rows to test multiple batches)
statement ok
CREATE TABLE insert_source AS SELECT i AS id, 'name_' || i AS name FROM range(20000) t(i);

# Test adbc_insert with create mode
query I
SELECT * FROM adbc_insert('db', 'bulk_test', (SELECT * FROM insert_source), mode := 'create');
----
20000

# Verify the data was inserted
query I
SELECT COUNT(*) FROM adbc_scan('db', 'SELECT * FROM bulk_test', columns := {'id': 'BIGINT', 'name': 'VARCHAR'});
----
20000

# Test adbc_insert with append mode
query I
SELECT * FROM adbc_insert('db', 'bulk_test', (SELECT * FROM insert_source WHERE id < 1000), mode := 'append');
----
1000

# Verify append worked
query I
SELECT COUNT(*) FROM adbc_scan('db', 'SELECT * FROM bulk_test', columns := {'id': 'BIGINT', 'name': 'VARCHAR'});
----
21000

# Test adbc_insert with an unknown database name
statement error
SELECT * FROM adbc_insert('nope', 'test', (SELECT 1));
----
Binder Error: adbc_insert: no attached database named "nope"

# Test adbc_insert with invalid mode
statement error
SELECT * FROM adbc_insert('db', 'test', (SELECT 1), mode := 'invalid');
----
Invalid Input Error: adbc_insert: Invalid mode 'invalid'. Must be one of: create, append, replace, create_append

# ============================================
# Statement options
# ============================================

# STRUCT form: options reach the driver (SQLite honors adbc.ingest.temporary)
query I
SELECT * FROM adbc_insert('db', 'tmp_ingest', (SELECT * FROM insert_source WHERE id < 10), mode := 'create', options := {'adbc.ingest.temporary': 'true'});
----
10

query I
SELECT COUNT(*) FROM adbc_scan('db', 'SELECT * FROM temp.tmp_ingest', columns := {'id': 'BIGINT', 'name': 'VARCHAR'});
----
10

query I
SELECT COUNT(*) FROM adbc_scan('db', 'SELECT name FROM main.sqlite_master WHERE name = ''tmp_ingest''', columns := {'name': 'VARCHAR'});
----
0

# MAP form
query I
SELECT * FROM adbc_insert('db', 'tmp_ingest_map', (SELECT * FROM insert_source WHERE id < 5), mode := 'create', options := MAP {'adbc.ingest.temporary': 'true'});
----
5

query I
SELECT COUNT(*) FROM adbc_scan('db', 'SELECT * FROM temp.tmp_ingest_map', columns := {'id': 'BIGINT', 'name': 'VARCHAR'});
----
5

# Options owned by adbc_insert itself are rejected
statement error
SELECT * FROM adbc_insert('db', 'x', (SELECT 1), options := {'adbc.ingest.mode': 'adbc.ingest.mode.replace'});
----
Invalid Input Error: adbc_insert: option 'adbc.ingest.mode' is set by adbc_insert itself

# options must be a STRUCT or MAP
statement error
SELECT * FROM adbc_insert('db', 'x', (SELECT 1), options := 'adbc.ingest.temporary=true');
----
Invalid Input Error: adbc_insert: options must be a STRUCT or MAP

# Options the driver does not recognize surface the driver's error
statement error
SELECT * FROM adbc_insert('db', 'x', (SELECT 1), mode := 'create', options := {'not.a.real.option': 'x'});
----
Failed to set statement option 'not.a.real.option'

# Clean up
statement ok
DETACH db;

statement ok
DROP TABLE insert_source;
