# name: test/sql/adbc_mysql_wide_decimal.test
# description: Decimals wider than DuckDB's DECIMAL(38) are returned as DOUBLE (issue #18)
# group: [adbc]
#
# MySQL reports SUM(BIGINT) as DECIMAL(41,0), which the driver sends as an Arrow
# Decimal256. DuckDB's DECIMAL tops out at 38 digits and its Arrow reader rejects
# these, so the scanner maps them to DOUBLE (as the DuckDB mysql/postgres scanners do).
#
# Requires the mysql ADBC driver and a MySQL server at
# mysql://root:root@localhost:3306/testdb. Gate by setting ADBC_MYSQL_TEST_AVAILABLE=1.

require adbc_scanner

require-env ADBC_MYSQL_TEST_AVAILABLE

statement ok
ATTACH 'mysql://root:root@localhost:3306/testdb' AS my (TYPE adbc, driver 'mysql');

statement ok
CALL adbc_execute('my', 'DROP TABLE IF EXISTS adbc_my_wide');

statement ok
CALL adbc_execute('my', 'CREATE TABLE adbc_my_wide (id INT PRIMARY KEY, v BIGINT, a DECIMAL(41,0), b DECIMAL(65,30), c DECIMAL(10,2))');

statement ok
CALL adbc_execute('my', 'INSERT INTO adbc_my_wide VALUES
  (1, 9223372036854775807, 12345678901234567890123456789012345678901, 1.5, 1.25),
  (2, 5, -12345678901234567890123456789012345678901, -0.000000000000000000000000000001, -3.50),
  (3, NULL, NULL, NULL, NULL),
  (4, 0, 0, 0, 0),
  (5, -1, 99999999999999999999999999999999999999999, -99999999999999999999999999999999999.999999999999999999999999999999, 0.01)');

# The originally reported failure (there via a stored procedure): SUM(BIGINT)
# is DECIMAL(41,0) / Decimal256.
query IT
SELECT total, typeof(total) FROM adbc_scan('my', 'SELECT SUM(v) AS total FROM adbc_my_wide');
----
9.223372036854776e+18	DOUBLE

# Values are correctly rounded (match MySQL's own DOUBLE conversion); nulls,
# zero and negatives survive; DECIMAL(<=38) columns keep their exact type.
query IRRT
SELECT id, a, b, c::VARCHAR FROM adbc_scan('my', 'SELECT id, a, b, c FROM adbc_my_wide') ORDER BY id;
----
1	1.2345678901234568e+40	1.5	1.25
2	-1.2345678901234568e+40	-1e-30	-3.50
3	NULL	NULL	NULL
4	0.0	0.0	0.00
5	1e+41	-1e+35	0.01

# Simultaneous scans use independent ADBC connections: two attachments (scans
# of one attachment share its connection).
statement ok
ATTACH 'mysql://root:root@localhost:3306/testdb' AS my_peer (TYPE adbc, driver 'mysql');

query I
SELECT count(*) FROM adbc_scan('my', 'SELECT id, a, b FROM adbc_my_wide') w
JOIN adbc_scan('my_peer', 'SELECT id, CAST(a AS DOUBLE) AS a, CAST(b AS DOUBLE) AS b FROM adbc_my_wide') m USING (id)
WHERE w.a IS NOT DISTINCT FROM m.a AND w.b IS NOT DISTINCT FROM m.b;
----
5

statement ok
DETACH my_peer;

query TT
SELECT field_name, field_type FROM adbc_schema('my', 'adbc_my_wide') WHERE field_name IN ('a', 'b', 'c') ORDER BY field_name;
----
a	DOUBLE
b	DOUBLE
c	DECIMAL(10,2)

# adbc_scan_table, including filter pushdown on a wide decimal column.
query IR
SELECT id, a FROM adbc_scan_table('my', 'adbc_my_wide') WHERE a > 0 ORDER BY id;
----
1	1.2345678901234568e+40
5	1e+41

# ATTACH storage path.
query IR
SELECT id, b FROM my.main.adbc_my_wide WHERE b < 0 ORDER BY id;
----
2	-1e-30
5	-1e+35

# Cleanup
statement ok
CALL adbc_execute('my', 'DROP TABLE IF EXISTS adbc_my_wide');

statement ok
DETACH my;
