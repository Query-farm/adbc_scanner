# name: test/sql/adbc_postgres_credentials.test
# description: Secret USERNAME / PASSWORD / DATABASE reach a URI-only driver through the URI
# group: [adbc]
#
# Requires the postgresql ADBC driver and a PostgreSQL server reachable at
# postgresql://postgres:postgres@localhost:5432/postgres. Gate by setting
# ADBC_POSTGRES_TEST_AVAILABLE=1, like adbc_postgres.test.

require adbc_scanner

require-env ADBC_POSTGRES_TEST_AVAILABLE

# The PostgreSQL driver accepts only 'uri', so these are folded into it
statement ok
CREATE SECRET pg_creds (
    TYPE adbc,
    DRIVER 'postgresql',
    URI 'postgresql://localhost:5432',
    USERNAME 'postgres',
    PASSWORD 'postgres',
    DATABASE 'postgres'
);

statement ok
ATTACH 'postgresql://localhost:5432' AS pg (TYPE adbc);

query II
SELECT * FROM adbc_scan('pg', 'SELECT current_user::text AS u, current_database()::text AS d',
    columns := {'u': 'VARCHAR', 'd': 'VARCHAR'});
----
postgres	postgres

statement ok
DETACH pg;

# Explicit ATTACH options take the same path
statement ok
ATTACH '' AS pg_opts (TYPE adbc, driver 'postgresql', uri 'postgresql://localhost:5432/postgres',
    username 'postgres', password 'postgres');

query I
SELECT * FROM adbc_scan('pg_opts', 'SELECT current_user::text AS u', columns := {'u': 'VARCHAR'});
----
postgres

statement ok
DETACH pg_opts;

# Credentials already in the URI are not merged; the driver's rejection stands
statement error
ATTACH '' AS pg_both (TYPE adbc, driver 'postgresql', uri 'postgresql://postgres@localhost:5432/postgres',
    username 'postgres');
----
Unknown database option username

# A URI whose query string contains '=' attaches as a URI
statement ok
ATTACH 'postgresql://postgres:postgres@localhost:5432/postgres?sslmode=disable' AS pg_query (TYPE adbc, driver 'postgresql');

query I
SELECT * FROM adbc_scan('pg_query', 'SELECT 1::bigint AS one', columns := {'one': 'BIGINT'});
----
1
