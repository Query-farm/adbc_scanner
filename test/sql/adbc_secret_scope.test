# name: test/sql/adbc_secret_scope.test
# description: URI-derived ADBC secret scope without loading a driver
# group: [adbc]

require adbc_scanner

statement ok
CREATE SECRET inferred_scope (TYPE adbc, DRIVER 'unused', URI 'grainlift+iroh://endpoint-a');

query I
SELECT scope = ['grainlift+iroh://endpoint-a'] FROM duckdb_secrets() WHERE name = 'inferred_scope';
----
true

statement ok
CREATE SECRET explicit_scope (TYPE adbc, DRIVER 'unused', URI 'postgresql://host/db', SCOPE 'postgresql://host');

query I
SELECT scope = ['postgresql://host'] FROM duckdb_secrets() WHERE name = 'explicit_scope';
----
true

statement ok
CREATE SECRET scope_only (TYPE adbc, DRIVER 'unused', SCOPE 'custom://host');

query I
SELECT scope = ['custom://host'] FROM duckdb_secrets() WHERE name = 'scope_only';
----
true

statement error
CREATE SECRET missing_scope (TYPE adbc, DRIVER 'unused');
----
ADBC secret requires a non-empty URI or an explicit SCOPE

statement error
CREATE SECRET empty_uri (TYPE adbc, DRIVER 'unused', URI '');
----
ADBC secret requires a non-empty URI or an explicit SCOPE

statement error
CREATE SECRET null_uri (TYPE adbc, DRIVER 'unused', URI NULL);
----
ADBC secret requires a non-empty URI or an explicit SCOPE

statement ok
DROP SECRET inferred_scope;

statement ok
DROP SECRET explicit_scope;

statement ok
DROP SECRET scope_only;
