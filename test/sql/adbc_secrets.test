# name: test/sql/adbc_secrets.test
# description: test adbc secrets integration
# group: [adbc]

require adbc_scanner

require-env HAS_ADBC_SQLITE_DRIVER

# Test creating an ADBC secret with scope
statement ok
CREATE SECRET my_sqlite_secret (
    TYPE adbc,
    SCOPE 'sqlite://:memory:',
    driver 'sqlite',
    uri ':memory:'
);

# Test connecting using a secret by URI scope
statement ok
ATTACH 'sqlite://:memory:' AS secret_db (TYPE adbc);

# Verify the connection works
query II
SELECT * FROM adbc_scan('secret_db', 'SELECT 1 AS a, 2 AS b', columns := {'a': 'BIGINT', 'b': 'BIGINT'});
----
1	2

# Clean up
statement ok
DETACH secret_db;

# Test connecting with explicit secret name
statement ok
CREATE SECRET named_sqlite_secret (
    TYPE adbc,
    SCOPE 'sqlite://named',
    driver 'sqlite',
    uri ':memory:'
);

statement ok
ATTACH '' AS named_db (TYPE adbc, secret 'named_sqlite_secret');

# Verify the connection works
query II
SELECT * FROM adbc_scan('named_db', 'SELECT 3 AS x, 4 AS y', columns := {'x': 'BIGINT', 'y': 'BIGINT'});
----
3	4

# Clean up
statement ok
DETACH named_db;

# Test that explicit options override secret options
statement ok
CREATE SECRET override_test_secret (
    TYPE adbc,
    SCOPE 'sqlite://override',
    driver 'sqlite',
    uri '/nonexistent/path.db'
);

# The explicit uri should override the secret's uri (which would fail)
statement ok
ATTACH ':memory:' AS override_db (TYPE adbc, secret 'override_test_secret');

query I
SELECT * FROM adbc_scan('override_db', 'SELECT 42 AS val', columns := {'val': 'BIGINT'});
----
42

statement ok
DETACH override_db;

# Test error when referencing non-existent secret by name
statement error
ATTACH '' AS missing_db (TYPE adbc, secret 'nonexistent_secret');
----
Binder Error: Secret with name "nonexistent_secret" not found

# Test extra_options for driver-specific parameters
statement ok
CREATE SECRET extra_opts_secret (
    TYPE adbc,
    SCOPE 'sqlite://extra',
    driver 'sqlite',
    uri ':memory:'
);

statement ok
ATTACH 'sqlite://extra' AS extra_db (TYPE adbc);

query I
SELECT * FROM adbc_scan('extra_db', 'SELECT 100 AS val', columns := {'val': 'BIGINT'});
----
100

statement ok
DETACH extra_db;

# URI alone supports automatic lookup and a real driver connection.
statement ok
CREATE SECRET inferred_sqlite_secret (TYPE adbc, DRIVER 'sqlite', URI ':memory:');

statement ok
ATTACH ':memory:' AS inferred_db (TYPE adbc);

query I
SELECT * FROM adbc_scan('inferred_db', 'SELECT 123 AS value', columns := {'value': 'BIGINT'});
----
123

statement ok
DETACH inferred_db;

statement ok
DROP SECRET inferred_sqlite_secret;

# Clean up secrets
statement ok
DROP SECRET my_sqlite_secret;

statement ok
DROP SECRET named_sqlite_secret;

statement ok
DROP SECRET override_test_secret;

statement ok
DROP SECRET extra_opts_secret;
