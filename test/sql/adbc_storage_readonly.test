# name: test/sql/adbc_storage_readonly.test
# description: writes to a READ_ONLY attached ADBC database are rejected
# group: [adbc]

require adbc_scanner

require-env HAS_ADBC_SQLITE_DRIVER

statement ok
SET VARIABLE c = (SELECT adbc_connect({'driver': 'sqlite', 'uri': '/tmp/test_ro.db'}));

statement ok
SELECT adbc_execute(getvariable('c')::BIGINT, 'DROP TABLE IF EXISTS t');

statement ok
SELECT adbc_execute(getvariable('c')::BIGINT, 'CREATE TABLE t (id INTEGER)');

statement ok
SELECT adbc_execute(getvariable('c')::BIGINT, 'INSERT INTO t VALUES (1), (2)');

statement ok
SELECT adbc_disconnect(getvariable('c')::BIGINT);

statement ok
ATTACH '/tmp/test_ro.db' AS ro (TYPE adbc, driver 'sqlite', READ_ONLY);

query I
SELECT COUNT(*) FROM ro.t;
----
2

statement error
INSERT INTO ro.t VALUES (3);
----

statement ok
DETACH ro;
