# name: test/sql/adbc_storage_readonly.test
# description: writes to a READ_ONLY attached ADBC database are rejected
# group: [adbc]

require adbc_scanner

require-env HAS_ADBC_SQLITE_DRIVER

statement ok
ATTACH '__TEST_DIR__/test_ro.db' AS setup_db (TYPE adbc, driver 'sqlite');

statement ok
CALL adbc_execute('setup_db', 'DROP TABLE IF EXISTS t');

statement ok
CALL adbc_execute('setup_db', 'CREATE TABLE t (id INTEGER)');

statement ok
CALL adbc_execute('setup_db', 'INSERT INTO t VALUES (1), (2)');

statement ok
DETACH setup_db;

statement ok
ATTACH '__TEST_DIR__/test_ro.db' AS ro (TYPE adbc, driver 'sqlite', READ_ONLY);

query I
SELECT COUNT(*) FROM ro.t;
----
2

statement error
INSERT INTO ro.t VALUES (3);
----

# adbc_execute / adbc_insert write, so they are rejected on a read-only attachment
statement error
CALL adbc_execute('ro', 'INSERT INTO t VALUES (3)');
----
adbc_execute: "ro" is attached read-only

statement error
SELECT * FROM adbc_insert('ro', 't', (SELECT 3 AS id), mode := 'append');
----
adbc_insert: "ro" is attached read-only

# Reads through adbc_scan still work
query I
SELECT COUNT(*) FROM adbc_scan('ro', 'SELECT id FROM t', columns := {'id': 'BIGINT'});
----
2

statement ok
DETACH ro;
