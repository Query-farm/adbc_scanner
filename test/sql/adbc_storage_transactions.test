# name: test/sql/adbc_storage_transactions.test
# description: real transactions for attached ADBC databases (BEGIN/COMMIT/ROLLBACK)
# group: [adbc]

require adbc_scanner

require-env HAS_ADBC_SQLITE_DRIVER

statement ok
ATTACH '__TEST_DIR__/test_storage_txn.db' AS w (TYPE adbc, driver 'sqlite');

# Clean slate
statement ok
CALL adbc_execute('w', 'DROP TABLE IF EXISTS t');

# Seed with 3 committed rows
statement ok
CREATE TABLE w.t AS SELECT i AS id FROM range(3) t(i);

query I
SELECT COUNT(*) FROM w.t;
----
3

# ROLLBACK must undo the insert
statement ok
BEGIN;

statement ok
INSERT INTO w.t SELECT i AS id FROM range(100, 110) t(i);

statement ok
ROLLBACK;

query I
SELECT COUNT(*) FROM w.t;
----
3

# COMMIT must persist the insert
statement ok
BEGIN;

statement ok
INSERT INTO w.t SELECT i AS id FROM range(100, 110) t(i);

statement ok
COMMIT;

query I
SELECT COUNT(*) FROM w.t;
----
13

# adbc_execute inside an explicit transaction joins it: it rolls back together
# with writes made through the catalog...
statement ok
BEGIN;

statement ok
CALL adbc_execute('w', 'INSERT INTO t VALUES (200)');

statement ok
INSERT INTO w.t VALUES (201);

# reads inside the transaction see its uncommitted adbc_execute writes
query I
SELECT COUNT(*) FROM adbc_scan('w', 'SELECT id FROM t', columns := {'id': 'BIGINT'});
----
15

statement ok
ROLLBACK;

query I
SELECT COUNT(*) FROM adbc_scan('w', 'SELECT id FROM t', columns := {'id': 'BIGINT'});
----
13

# ...and commits together
statement ok
BEGIN;

statement ok
CALL adbc_execute('w', 'INSERT INTO t VALUES (300)');

statement ok
INSERT INTO w.t VALUES (301);

statement ok
COMMIT;

query I
SELECT COUNT(*) FROM w.t;
----
15

# Outside a transaction adbc_execute autocommits
statement ok
CALL adbc_execute('w', 'DELETE FROM t WHERE id >= 300');

query I
SELECT COUNT(*) FROM adbc_scan('w', 'SELECT id FROM t', columns := {'id': 'BIGINT'});
----
13

statement ok
DETACH w;
