# name: test/sql/adbc_storage_transactions.test
# description: real transactions for attached ADBC databases (BEGIN/COMMIT/ROLLBACK)
# group: [adbc]

require adbc_scanner

require-env HAS_ADBC_SQLITE_DRIVER

# Clean slate
statement ok
SET VARIABLE c = (SELECT adbc_connect({'driver': 'sqlite', 'uri': '/tmp/test_storage_txn.db'}));

statement ok
SELECT adbc_execute(getvariable('c')::BIGINT, 'DROP TABLE IF EXISTS t');

statement ok
SELECT adbc_disconnect(getvariable('c')::BIGINT);

statement ok
ATTACH '/tmp/test_storage_txn.db' AS w (TYPE adbc, driver 'sqlite');

# Seed with 3 committed rows
statement ok
CREATE TABLE w.t AS SELECT i AS id FROM range(3) t(i);

query I
SELECT COUNT(*) FROM w.t;
----
3

# ROLLBACK must undo the insert
statement ok
BEGIN;

statement ok
INSERT INTO w.t SELECT i AS id FROM range(100, 110) t(i);

statement ok
ROLLBACK;

query I
SELECT COUNT(*) FROM w.t;
----
3

# COMMIT must persist the insert
statement ok
BEGIN;

statement ok
INSERT INTO w.t SELECT i AS id FROM range(100, 110) t(i);

statement ok
COMMIT;

query I
SELECT COUNT(*) FROM w.t;
----
13

statement ok
DETACH w;
