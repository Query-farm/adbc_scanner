# name: test/sql/adbc_transactions.test
# description: adbc_execute / adbc_scan follow DuckDB transactions on the attached database
# group: [adbc]

require adbc_scanner

require-env HAS_ADBC_SQLITE_DRIVER

# A file database, so the attachment's connections share one SQLite database.
statement ok
ATTACH '__TEST_DIR__/adbc_transactions.db' AS db (TYPE adbc, driver 'sqlite');

statement ok
CALL adbc_execute('db', 'DROP TABLE IF EXISTS tx_test');

# Outside a transaction adbc_execute autocommits
statement ok
CALL adbc_execute('db', 'CREATE TABLE tx_test (id INTEGER, qty INTEGER)');

# ROLLBACK undoes adbc_execute writes made inside the transaction
statement ok
BEGIN;

statement ok
CALL adbc_execute('db', 'INSERT INTO tx_test VALUES (1, 10)');

# Reads inside the transaction see its own uncommitted writes
query I
SELECT count(*) FROM adbc_scan('db', 'SELECT * FROM tx_test', columns := {'id': 'BIGINT', 'qty': 'BIGINT'});
----
1

statement ok
ROLLBACK;

query I
SELECT count(*) FROM adbc_scan('db', 'SELECT * FROM tx_test', columns := {'id': 'BIGINT', 'qty': 'BIGINT'});
----
0

# A scan prepared outside a transaction resolves the database when it runs, so
# inside one it still sees the transaction's uncommitted writes
statement ok
PREPARE tx_count AS SELECT count(*) FROM adbc_scan('db', 'SELECT * FROM tx_test', columns := {'id': 'BIGINT', 'qty': 'BIGINT'});

statement ok
BEGIN;

statement ok
CALL adbc_execute('db', 'INSERT INTO tx_test VALUES (1, 10)');

query I
EXECUTE tx_count;
----
1

statement ok
ROLLBACK;

query I
EXECUTE tx_count;
----
0

# adbc_execute and writes through the catalog commit together
statement ok
BEGIN;

statement ok
CALL adbc_execute('db', 'INSERT INTO tx_test VALUES (2, 20)');

statement ok
INSERT INTO db.main.tx_test VALUES (3, 30);

statement ok
COMMIT;

query II
SELECT * FROM adbc_scan('db', 'SELECT id, qty FROM tx_test ORDER BY id', columns := {'id': 'BIGINT', 'qty': 'BIGINT'});
----
2	20
3	30

# ...and roll back together
statement ok
BEGIN;

statement ok
CALL adbc_execute('db', 'INSERT INTO tx_test VALUES (4, 40)');

statement ok
INSERT INTO db.main.tx_test VALUES (5, 50);

statement ok
ROLLBACK;

query I
SELECT count(*) FROM adbc_scan('db', 'SELECT * FROM tx_test', columns := {'id': 'BIGINT', 'qty': 'BIGINT'});
----
2

statement ok
DETACH db;

# A read-only attachment rejects adbc_execute, outside and inside a transaction
statement ok
ATTACH '__TEST_DIR__/adbc_transactions.db' AS ro_db (TYPE adbc, driver 'sqlite', READ_ONLY);

statement error
CALL adbc_execute('ro_db', 'INSERT INTO tx_test VALUES (6, 60)');
----
Permission Error: adbc_execute: "ro_db" is attached read-only

statement ok
BEGIN;

statement error
CALL adbc_execute('ro_db', 'INSERT INTO tx_test VALUES (7, 70)');
----
Permission Error: adbc_execute: "ro_db" is attached read-only

statement ok
ROLLBACK;

# Reads still work on a read-only attachment
query I
SELECT count(*) FROM adbc_scan('ro_db', 'SELECT * FROM tx_test', columns := {'id': 'BIGINT', 'qty': 'BIGINT'});
----
2

statement ok
DETACH ro_db;
